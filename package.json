{
  "name": "claude-sessions",
  "productName": "Claude Sessions",
  "version": "0.2.3",
  "description": "Unofficial desktop app to browse, organize, search and continue your Claude Code sessions",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && env -u ELECTRON_RUN_AS_NODE VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.cjs",
    "test:e2e:live": "CC_LIVE=1 node --test --test-concurrency=1 test/e2e/*.test.cjs",
    "dist": "vite build && electron-builder --linux deb --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "minisearch": "^7.2.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0",
    "vite": "^5.4.21",
    "wait-on": "^9.5.1"
  },
  "author": {
    "name": "sudnu-odoo",
    "email": "sudnu@odoo.com"
  },
  "build": {
    "appId": "io.github.sudnu-odoo.claude-sessions",
    "productName": "Claude Sessions",
    "executableName": "claude-sessions",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "assets/icon.svg",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/playwright-core/**"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "assets/icons",
      "category": "Development",
      "synopsis": "Browse, organize, search and continue your Claude Code sessions",
      "description": "A desktop app for Claude Code: sessions grouped by category and workspace, full-text search, live chats with approvals, slash commands, usage and MCP screens.",
      "desktop": {
        "entry": {
          "Name": "Claude Sessions",
          "StartupWMClass": "claude-sessions",
          "Keywords": "claude;code;ai;sessions;chat;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "claude-sessions",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "homepage": "https://github.com/sudnu-odoo/claude-session",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudnu-odoo/claude-session.git"
  },
  "desktopName": "claude-sessions.desktop"
}
